generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
//   url      = env("DATABASE_URL")
  url      = "../"
}

enum ContentType {
  BLOG
  NEWS
  ARTICLE
}
model Language {
  id        String @id @default(cuid())
  code      String @unique
  name      String

  createdAt DateTime @default(now())
}
model Product {
  id            String @id @default(cuid())

  slug          String @unique

  imageUrl      String

  categoryId    String
  subCategoryId String?
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category
  subCategory SubCategory?

  translations ProductTranslation[]
}
model ProductTranslation {
  id String @id @default(cuid())

  productId String

  languageId String

  name String

  description String @db.Text

  specifications String @db.Text
  slug String

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  product Product @relation(fields: [productId], references: [id])

  language Language @relation(fields: [languageId], references: [id])

  @@unique([productId, languageId])
}
model Category {
  id String @id @default(cuid())

  slug String @unique

  imageUrl String

  createdAt DateTime @default(now())
  published Boolean @default(false)
  products Product[]

  translations CategoryTranslation[]

  subCategories SubCategory[]
}
model CategoryTranslation {
  id String @id @default(cuid())

  categoryId String

  languageId String

  name String

  seoTitle String?

  seoDescription String?

  category Category @relation(fields: [categoryId], references: [id])

  language Language @relation(fields: [languageId], references: [id])

  @@unique([categoryId, languageId])
}
model SubCategory {
  id String @id @default(cuid())

  categoryId String

  slug String @unique

  imageUrl String
  published Boolean @default(false)
  category Category @relation(fields: [categoryId], references: [id])

  products Product[]

  translations SubCategoryTranslation[]
  
}
model SubCategoryTranslation {
  id String @id @default(cuid())

  subCategoryId String

  languageId String

  name String

  seoTitle String?

  seoDescription String?

  category Category @relation(fields: [subCategoryId], references: [id])

  language Language @relation(fields: [languageId], references: [id])

  @@unique([subCategoryId, languageId])
}
model Content {
  id String @id @default(cuid())

  slug String @unique

  coverImage String

  type ContentType
  
  published Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime @default(now())

  translations ContentTranslation[]
}
model ContentTranslation {
  id String @id @default(cuid())

  contentId String

  languageId String

  title String

  excerpt String?

  body String @db.Text

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  content Content @relation(fields: [contentId], references: [id])

  language Language @relation(fields: [languageId], references: [id])

  @@unique([contentId, languageId])
}
model PriceTicker {
  id String @id @default(cuid())

  sortOrder Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())

  translations PriceTickerTranslation[]
}
model PriceTickerTranslation {
  id String @id @default(cuid())

  tickerId String

  languageId String

  productName String

  price String

  ticker PriceTicker @relation(fields: [tickerId], references: [id])

  language Language @relation(fields: [languageId], references: [id])

  @@unique([tickerId, languageId])
}