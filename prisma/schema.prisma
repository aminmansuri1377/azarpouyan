generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  BLOG
  NEWS
  ARTICLE
}

model Language {
  id   String @id @default(cuid())
  code String @unique
  name String
  enabled Boolean @default(true)

  sortOrder Int @default(0)
  createdAt DateTime @default(now())

  productTranslations     ProductTranslation[]
  categoryTranslations    CategoryTranslation[]
  subCategoryTranslations SubCategoryTranslation[]
  contentTranslations     ContentTranslation[]
  tickerTranslations      PriceTickerTranslation[]
}

model Category {
  id String @id @default(cuid())

  slug String @unique

  imageUrl String

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  subCategories SubCategory[]

  translations CategoryTranslation[]

  @@index([published])
}

model CategoryTranslation {
  id String @id @default(cuid())

  categoryId String

  languageId String

  name String

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
}

model SubCategory {
  id String @id @default(cuid())

  categoryId String

  slug String @unique

  imageUrl String

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  translations SubCategoryTranslation[]

  @@index([categoryId])
}

model SubCategoryTranslation {
  id String @id @default(cuid())

  subCategoryId String

  languageId String

  name String

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([subCategoryId, languageId])
}

model Product {
  id String @id @default(cuid())

  slug String @unique

  imageUrl String

  categoryId String

  subCategoryId String?

  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  translations ProductTranslation[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([published])
}

model ProductTranslation {
  id String @id @default(cuid())

  productId String

  languageId String

  name String

  description String

  specifications String

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([productId, languageId])
}

model Content {
  id String @id @default(cuid())

  slug String @unique

  type ContentType

  coverImage String

  published Boolean @default(false)

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations ContentTranslation[]

  @@index([type])
  @@index([published])
}

model ContentTranslation {
  id String @id @default(cuid())

  contentId String

  languageId String

  title String

  excerpt String?

  body String

  seoTitle String?

  seoDescription String?

  seoKeywords String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([contentId, languageId])
}

model PriceTicker {
  id String @id @default(cuid())

  active Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PriceTickerTranslation[]

  @@index([active])
  @@index([sortOrder])
}

model PriceTickerTranslation {
  id String @id @default(cuid())

  tickerId String

  languageId String

  productName String

  price String

  ticker PriceTicker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([tickerId, languageId])
}
